# -----------------------------------------------------------------------------
export PATH="$LLM_TOOLS/llama.cpp/build/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
export GOPATH="$HOME/.local/share/go"

# -----------------------------------------------------------------------------
# Defaults
# -----------------------------------------------------------------------------
export SYSTEMD_EDITOR=nvim
export VISUAL=nvim
export EDITOR=nvim

# -----------------------------------------------------------------------------
# ENV VARS
# -----------------------------------------------------------------------------

export WIKI_HOME="/data/llms/knowledge_base"

export OMP_DECK_DEFAULT_CWD="/data/llms/projects/"
export OMP_DECK_DB_PATH="$HOME/.config/omp-deck/deck.db"

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
