#!/usr/bin/env bash
set -Eeuo pipefail

# ============================================================
# Configuration
# ============================================================

IMAGE="localhost/thoth:debian13"
WORKSPACES_DIR="/data/llms/agent_workspaces"
CONTAINER_PREFIX="thoth"

CONTAINER_UID=1000
CONTAINER_GID=1000

BASE_OMP_PORT=3000
BASE_VITE_PORT=5173
BASE_API_PORT=8000

PORT_STEP=1000
MAX_PORT_OFFSET=57000

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

# Prompt for a 1-based index into a list of $2 items.
# Prints the chosen index on stdout; prompts and diagnostics go to stderr.
prompt_choice() {
    local prompt="$1"
    local count="$2"
    local choice

    while true; do
        read -r -p "$prompt" choice || return 1

        case "${choice,,}" in
            q|quit|exit)
                printf 'Cancelled.\n' >&2
                return 1
                ;;
        esac

        [[ "$choice" =~ ^[0-9]+$ ]] || {
            printf 'Invalid selection.\n' >&2
            continue
        }

        choice=$((10#$choice))

        if (( choice < 1 || choice > count )); then
            printf 'Choose a number between 1 and %d.\n' "$count" >&2
            continue
        fi

        printf '%d\n' "$choice"
        return 0
    done
}

# Encode a directory the way omp names its session bucket:
#   -<relative>      under $HOME
#   -tmp-<relative>  under the temp root
#   --<absolute>--   anywhere else
# with path separators replaced by '-'. Mirrors omp's session-paths.ts.
omp_session_bucket() {
    local cwd="$1"
    local home="${HOME%/}"
    local tmp="${TMPDIR:-/tmp}"
    local rel

    tmp="${tmp%/}"

    if [[ "$cwd" == "$tmp" ]]; then
        printf '%s\n' '-tmp'
    elif [[ "$cwd" == "$tmp/"* ]]; then
        rel="${cwd#"$tmp"/}"
        printf '%s\n' "-tmp-${rel//\//-}"
    elif [[ "$cwd" == "$home" ]]; then
        printf '%s\n' '-'
    elif [[ "$cwd" == "$home/"* ]]; then
        rel="${cwd#"$home"/}"
        printf '%s\n' "-${rel//\//-}"
    else
        rel="${cwd#/}"
        printf '%s\n' "--${rel//\//-}--"
    fi
}

# ============================================================
# Requirements
# ============================================================

command -v podman >/dev/null 2>&1 || fail "Podman is not installed."
command -v omp >/dev/null 2>&1 || fail "OMP is not installed."
command -v ss >/dev/null 2>&1 || fail "Install iproute2 (ss is required)."

(( $# == 0 )) || fail "Run dev-container without arguments to open the workspace menu."

podman image exists "$IMAGE" || \
    fail "Container image not found: $IMAGE"

[[ -d "$WORKSPACES_DIR" ]] || \
    fail "Workspace directory does not exist: $WORKSPACES_DIR"

# ============================================================
# Scan workspaces
# ============================================================

# Only scan immediate, non-hidden directories.
# Files such as Dockerfile are ignored.

mapfile -d '' -t WORKSPACES < <(
    find "$WORKSPACES_DIR" \
        -mindepth 1 -maxdepth 1 \
        -type d ! -name '.*' \
        -printf '%f\0' | sort -z
)

((${#WORKSPACES[@]} > 0)) || \
    fail "No workspace directories found in: $WORKSPACES_DIR"

# Absolute path of every scanned workspace, indexed like WORKSPACES.
WORKSPACE_PATHS=()

for WORKSPACE_ENTRY in "${WORKSPACES[@]}"; do
    WORKSPACE_PATHS+=("$WORKSPACES_DIR/$WORKSPACE_ENTRY")
done

# Offer the current working directory as the first entry unless the
# scan already lists it.
CURRENT_DIR="$(pwd -P)" || \
    fail "Cannot resolve the current working directory."

CURRENT_DIR_NAME="${CURRENT_DIR##*/}"
CURRENT_DIR_LISTED=0

for WORKSPACE_PATH in "${WORKSPACE_PATHS[@]}"; do
    if [[ "$WORKSPACE_PATH" == "$CURRENT_DIR" ]]; then
        CURRENT_DIR_LISTED=1
        break
    fi
done

if (( CURRENT_DIR_LISTED == 0 )); then
    [[ -n "$CURRENT_DIR_NAME" ]] || CURRENT_DIR_NAME="/"

    WORKSPACES=("$CURRENT_DIR_NAME" "${WORKSPACES[@]}")
    WORKSPACE_PATHS=("$CURRENT_DIR" "${WORKSPACE_PATHS[@]}")
fi

# ============================================================
# Workspace selection
# ============================================================

[[ -t 0 ]] || \
    fail "Interactive selection requires a terminal."

printf '\nAvailable workspaces:\n\n'

for i in "${!WORKSPACES[@]}"; do
    if [[ "${WORKSPACE_PATHS[$i]}" == "$CURRENT_DIR" ]]; then
        printf '  %2d) %s (current directory)\n' "$((i + 1))" "${WORKSPACES[$i]}"
    else
        printf '  %2d) %s\n' "$((i + 1))" "${WORKSPACES[$i]}"
    fi
done

printf '\n'

SELECTION_NUMBER="$(prompt_choice "Select workspace number (or q to quit): " "${#WORKSPACES[@]}")" || exit 0

SELECTED_INDEX=$((SELECTION_NUMBER - 1))

WORKSPACE_NAME="${WORKSPACES[$SELECTED_INDEX]}"
PROJECT_DIR="${WORKSPACE_PATHS[$SELECTED_INDEX]}"
CONTAINER_NAME="$CONTAINER_PREFIX-$WORKSPACE_NAME"

[[ "$WORKSPACE_NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || \
    fail "Invalid workspace name: $WORKSPACE_NAME"

# Resolve symlinks once. The harnesses key their session stores on the
# canonical path, and the container must see the same path as the host.
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd -P)" || \
    fail "Cannot resolve the workspace directory: $PROJECT_DIR"

# Mount the workspace at its host path so path-keyed state (omp session
# buckets, opencode project ids, qoder project dirs) resolves identically
# inside and outside the container.
CONTAINER_WORKSPACE_DIR="$PROJECT_DIR"

# Git executes hooks and reads config from the workspace. Mount the hook
# directory and config read-only so a compromised agent cannot plant a hook or
# rewrite core.hooksPath/sshCommand that runs on the host at the next git
# command. The rest of .git stays writable so in-container commits work.
GIT_READONLY_MOUNTS=()

if command -v git >/dev/null 2>&1; then
    WORKSPACE_GIT_DIR="$(git -C "$PROJECT_DIR" rev-parse --absolute-git-dir 2>/dev/null || true)"

    if [[ -n "$WORKSPACE_GIT_DIR" && "$WORKSPACE_GIT_DIR" == "$PROJECT_DIR"/* ]]; then
        WORKSPACE_HOOKS_DIR="$(git -C "$PROJECT_DIR" rev-parse --git-path hooks 2>/dev/null || true)"
        [[ "$WORKSPACE_HOOKS_DIR" == /* ]] || WORKSPACE_HOOKS_DIR="$PROJECT_DIR/$WORKSPACE_HOOKS_DIR"

        if [[ -d "$WORKSPACE_HOOKS_DIR" && "$WORKSPACE_HOOKS_DIR" == "$PROJECT_DIR"/* ]]; then
            GIT_READONLY_MOUNTS+=(
                --mount "type=bind,src=$WORKSPACE_HOOKS_DIR,dst=$CONTAINER_WORKSPACE_DIR/${WORKSPACE_HOOKS_DIR#"$PROJECT_DIR"/},ro"
            )
        fi

        if [[ -f "$WORKSPACE_GIT_DIR/config" ]]; then
            GIT_READONLY_MOUNTS+=(
                --mount "type=bind,src=$WORKSPACE_GIT_DIR/config,dst=$CONTAINER_WORKSPACE_DIR/${WORKSPACE_GIT_DIR#"$PROJECT_DIR"/}/config,ro"
            )
        fi
    fi
fi

# ============================================================
# Agent harness selection
# ============================================================

# Harness command executed inside the container, in menu order.
AGENT_HARNESSES=(omp opencode qoder)

printf '\nAvailable agent harnesses:\n\n'

for i in "${!AGENT_HARNESSES[@]}"; do
    printf '  %2d) %s\n' "$((i + 1))" "${AGENT_HARNESSES[$i]}"
done

printf '\n'

HARNESS_NUMBER="$(prompt_choice "Select harness number (or q to quit): " "${#AGENT_HARNESSES[@]}")" || exit 0

HARNESS="${AGENT_HARNESSES[$((HARNESS_NUMBER - 1))]}"

# ============================================================
# Agent harness configuration
# ============================================================

OPENCODE_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
OPENCODE_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/opencode"
OPENCODE_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/opencode"
QODER_CONFIG_DIR="$HOME/.qoder"
OMP_PLUGINS_DIR="$HOME/.omp/plugins"
CLAUDE_SKILLS_DIR="$HOME/.claude/skills"
AGENTS_SKILLS_DIR="$HOME/.agents/skills"
OMARCHY_SKILLS_DIR="/usr/share/omarchy/default/agents/skills"

mkdir -p -- \
    "$OPENCODE_CONFIG_DIR" \
    "$OPENCODE_DATA_DIR" \
    "$OPENCODE_STATE_DIR" \
    "$QODER_CONFIG_DIR"

# ============================================================
# OMP configuration
# ============================================================

OMP_CONFIG_DIR="$(omp config path)" || \
    fail "Cannot resolve the OMP configuration path."

[[ -n "$OMP_CONFIG_DIR" ]] || \
    fail "OMP returned an empty configuration path."

[[ -d "$OMP_CONFIG_DIR" ]] || \
    fail "OMP configuration not found: $OMP_CONFIG_DIR"

# The container's cwd is the host path, so omp's cwd-derived bucket is the same
# on both sides. Point the container at it explicitly: the container's $HOME
# differs, and omp would otherwise encode an absolute bucket.
OMP_SESSION_BUCKET="$(omp_session_bucket "$PROJECT_DIR")"
OMP_SESSION_DIR="/home/dev/.omp/agent/sessions/$OMP_SESSION_BUCKET"

# ============================================================
# GitHub CLI authentication
# ============================================================

# Pass a GitHub token into the container so `gh` and HTTPS `git push`
# authenticate without any private key in the image. Only an explicitly
# exported token is forwarded: never fall back to `gh auth token`, which is the
# host's broad OAuth credential and would widen the blast radius for a
# sandboxed agent.
GH_TOKEN_VALUE="${LLM_GH_TOKEN:-${GH_TOKEN:-}}"

if [[ -n "$GH_TOKEN_VALUE" ]]; then
    export GH_TOKEN="$GH_TOKEN_VALUE"
else
    printf 'Warning: no GitHub token found; HTTPS git push will not authenticate.\n' >&2
    printf '         Export LLM_GH_TOKEN with a fine-grained PAT to enable it.\n' >&2
fi

# ============================================================
# Session resume
# ============================================================

format_bytes() {
    local n="$1"

    if (( n < 1024 )); then
        printf '%d B' "$n"
    elif (( n < 1048576 )); then
        printf '%d.%d KB' $((n / 1024)) $(((n % 1024) * 10 / 1024))
    elif (( n < 1073741824 )); then
        printf '%d.%d MB' $((n / 1048576)) $(((n % 1048576) * 10 / 1048576))
    else
        printf '%d.%d GB' $((n / 1073741824)) $(((n % 1073741824) * 10 / 1073741824))
    fi
}

format_date() {
    date -d "@$1" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$1"
}

truncate_text() {
    local text="$1"
    local max="${2:-60}"

    if (( ${#text} > max )); then
        printf '%s…' "${text:0:max-1}"
    else
        printf '%s' "$text"
    fi
}

# One line per session: id|title|bytes|mtime|messages|model
omp_sessions() {
    local bucket="$OMP_CONFIG_DIR/sessions/$OMP_SESSION_BUCKET"
    local file id title size mtime msgs model

    [[ -d "$bucket" ]] || return 0

    for file in "$bucket"/*.jsonl; do
        [[ -f "$file" ]] || continue

        id="${file##*/}"
        id="${id#*_}"
        id="${id%.jsonl}"

        title="$(head -n 1 "$file" | jq -r '.title // empty' 2>/dev/null || true)"
        [[ -n "$title" ]] || title="$(basename "$file" .jsonl)"
        title="${title//|/-}"

        size="$(stat -c %s "$file")"
        mtime="$(stat -c %Y "$file")"
        msgs="$(grep -cE '"type"[[:space:]]*:[[:space:]]*"message"' "$file" 2>/dev/null || true)"
        model="$(grep -m1 -o '"model":"[^"]*"' "$file" 2>/dev/null | cut -d'"' -f4 || true)"

        printf '%s|%s|%s|%s|%s|%s\n' "$id" "$title" "$size" "$mtime" "$msgs" "$model"
    done | sort -t'|' -k4,4nr
}

opencode_sessions() {
    local db="$OPENCODE_DATA_DIR/opencode.db"
    local query

    [[ -f "$db" ]] || return 0

    query="
        select s.id,
               replace(s.title, '|', '-'),
               coalesce((select sum(length(cast(p.data as blob))) from part p where p.session_id = s.id), 0),
               s.time_updated / 1000,
               (select count(*) from message m where m.session_id = s.id),
               coalesce(case when json_valid(s.model) then json_extract(s.model, '$.id') else s.model end, '')
        from session s
        where s.directory = '$PROJECT_DIR'
        order by s.time_updated desc;
    "

    if command -v sqlite3 >/dev/null 2>&1; then
        sqlite3 -noheader -separator '|' "$db" "$query" 2>/dev/null || true
    elif command -v opencode >/dev/null 2>&1; then
        opencode db "$query" 2>/dev/null | tail -n +2 || true
    fi
}

qoder_sessions() {
    local project="$QODER_CONFIG_DIR/projects/-${PROJECT_DIR#/}"
    local file id title size mtime msgs model

    project="${project//\//-}"

    [[ -d "$project" ]] || return 0

    for file in "$project"/*.jsonl; do
        [[ -f "$file" ]] || continue

        id="$(basename "$file" .jsonl)"
        title="$(jq -r 'select(.type == "user") | .message.content[0].text // empty' "$file" 2>/dev/null | head -n 1 || true)"
        [[ -n "$title" ]] || title="$id"
        title="${title//|/-}"

        size="$(stat -c %s "$file")"
        mtime="$(stat -c %Y "$file")"
        msgs="$(grep -cE '"type"[[:space:]]*:[[:space:]]*"user"' "$file" 2>/dev/null || true)"
        model="$(grep -m1 -o '"model":"[^"]*"' "$file" 2>/dev/null | cut -d'"' -f4 || true)"

        printf '%s|%s|%s|%s|%s|%s\n' "$id" "$title" "$size" "$mtime" "$msgs" "$model"
    done | sort -t'|' -k4,4nr
}

SESSIONS=()

case "$HARNESS" in
    omp)      mapfile -t SESSIONS < <(omp_sessions) ;;
    opencode) mapfile -t SESSIONS < <(opencode_sessions) ;;
    qoder)    mapfile -t SESSIONS < <(qoder_sessions) ;;
esac

SESSION_ID=""

if (( ${#SESSIONS[@]} > 0 )); then
    printf '\nSessions in this workspace:\n\n'
    printf '  %2s  %-16s  %8s  %5s  %s\n' '#' 'Modified' 'Size' 'Msgs' 'Title'

    for i in "${!SESSIONS[@]}"; do
        IFS='|' read -r id title size mtime msgs model <<< "${SESSIONS[$i]}"

        printf '  %2d  %-16s  %8s  %5s  %s\n' \
            "$((i + 1))" \
            "$(format_date "$mtime")" \
            "$(format_bytes "$size")" \
            "$msgs" \
            "$(truncate_text "$title" 60)"

        printf '      %s%s\n' "$id" "${model:+  $model}"
    done

    printf '\n  %2d) new session\n\n' "$(( ${#SESSIONS[@]} + 1 ))"

    printf 'Select session number (or q to quit): ' >&2
    read -r SESSION_CHOICE || SESSION_CHOICE=""

    case "${SESSION_CHOICE,,}" in
        q|quit|exit)
            exit 0
            ;;
        "")
            ;;
        *)
            if [[ "$SESSION_CHOICE" =~ ^[0-9]+$ ]]; then
                SESSION_NUMBER=$((10#$SESSION_CHOICE))

                if (( SESSION_NUMBER >= 1 && SESSION_NUMBER <= ${#SESSIONS[@]} )); then
                    IFS='|' read -r SESSION_ID _ _ _ _ _ <<< "${SESSIONS[$((SESSION_NUMBER - 1))]}"
                elif (( SESSION_NUMBER != ${#SESSIONS[@]} + 1 )); then
                    fail "Invalid session number: $SESSION_CHOICE"
                fi
            else
                fail "Invalid session number: $SESSION_CHOICE"
            fi
            ;;
    esac
fi

HARNESS_ARGS=()

if [[ -n "$SESSION_ID" ]]; then
    case "$HARNESS" in
        omp)      HARNESS_ARGS+=(--resume "$SESSION_ID") ;;
        opencode) HARNESS_ARGS+=(--session "$SESSION_ID") ;;
        qoder)    HARNESS_ARGS+=(--resume "$SESSION_ID") ;;
    esac
fi

# Paths the host harness loads as code. Mount them read-only over the writable
# config mounts so a compromised agent inside the container cannot plant an
# extension, agent, or plugin that runs on the host at its next start.
OMP_READONLY_MOUNTS=()

for OMP_CODE_DIR in extensions managed-skills agents memories; do
    [[ -d "$OMP_CONFIG_DIR/$OMP_CODE_DIR" ]] || continue
    OMP_READONLY_MOUNTS+=(
        --mount "type=bind,src=$OMP_CONFIG_DIR/$OMP_CODE_DIR,dst=/home/dev/.omp/agent/$OMP_CODE_DIR,ro"
    )
done

for OMP_CODE_FILE in config.yml models.yml; do
    [[ -f "$OMP_CONFIG_DIR/$OMP_CODE_FILE" ]] || continue
    OMP_READONLY_MOUNTS+=(
        --mount "type=bind,src=$OMP_CONFIG_DIR/$OMP_CODE_FILE,dst=/home/dev/.omp/agent/$OMP_CODE_FILE,ro"
    )
done

# Qoder's dispatcher, bundled runtime, plugin hooks, external-command registry,
# marketplace list, shell snapshots, and settings are all host-owned code or
# policy. Keep them read-only; only projects, logs, cache, and state stay rw.
QODER_READONLY_MOUNTS=()

for QODER_CODE_DIR in entry .bin security-resources external-commands plugins shell-snapshots; do
    [[ -d "$QODER_CONFIG_DIR/$QODER_CODE_DIR" ]] || continue
    QODER_READONLY_MOUNTS+=(
        --mount "type=bind,src=$QODER_CONFIG_DIR/$QODER_CODE_DIR,dst=/home/dev/.qoder/$QODER_CODE_DIR,ro"
    )
done

if [[ -f "$QODER_CONFIG_DIR/settings.json" ]]; then
    QODER_READONLY_MOUNTS+=(
        --mount "type=bind,src=$QODER_CONFIG_DIR/settings.json,dst=/home/dev/.qoder/settings.json,ro"
    )
fi

# OMP's npm plugins. Read-only: install and upgrade them on the host.
OMP_PLUGIN_MOUNTS=()

if [[ -d "$OMP_PLUGINS_DIR" ]]; then
    OMP_PLUGIN_MOUNTS+=(
        --mount "type=bind,src=$OMP_PLUGINS_DIR,dst=/home/dev/.omp/plugins,ro"
    )
fi

# Shared skill directories. OpenCode discovers ~/.claude/skills and
# ~/.agents/skills natively; OMP reads the same trees through its own config.
SKILL_MOUNTS=()

for SKILL_DIR in "$CLAUDE_SKILLS_DIR" "$AGENTS_SKILLS_DIR"; do
    [[ -d "$SKILL_DIR" ]] || continue
    SKILL_MOUNTS+=(
        --mount "type=bind,src=$SKILL_DIR,dst=/home/dev/${SKILL_DIR#"$HOME"/},ro"
    )
done

# ~/.agents/skills entries symlink into the Omarchy defaults; mount the target
# so those links resolve inside the container.
if [[ -d "$OMARCHY_SKILLS_DIR" ]]; then
    SKILL_MOUNTS+=(
        --mount "type=bind,src=$OMARCHY_SKILLS_DIR,dst=$OMARCHY_SKILLS_DIR,ro"
    )
fi

# OMP's agent frontmatter is not OpenCode-compatible: `model` is a list and
# `tools` is a list, while OpenCode expects a string model and a tools map.
# Generate OpenCode-shaped copies that keep the description and system prompt.
OPENCODE_AGENT_DIR="$OPENCODE_CONFIG_DIR/agents"

mkdir -p -- "$OPENCODE_AGENT_DIR"

if [[ -d "$OMP_CONFIG_DIR/agents" ]]; then
    for OMP_AGENT_FILE in "$OMP_CONFIG_DIR/agents"/*.md; do
        [[ -f "$OMP_AGENT_FILE" ]] || continue

        OMP_AGENT_NAME="$(basename "$OMP_AGENT_FILE" .md)"
        OMP_AGENT_DESC="$(awk '
            /^---$/ { n++; next }
            n == 1 && /^description:/ { sub(/^description:[[:space:]]*/, ""); print; exit }
        ' "$OMP_AGENT_FILE")"
        OMP_AGENT_DESC="${OMP_AGENT_DESC:-OMP $OMP_AGENT_NAME agent}"
        OMP_AGENT_DESC="${OMP_AGENT_DESC#\"}"
        OMP_AGENT_DESC="${OMP_AGENT_DESC%\"}"
        OMP_AGENT_DESC="${OMP_AGENT_DESC//\"/\\\"}"

        {
            printf -- '---\n'
            printf 'description: "%s"\n' "$OMP_AGENT_DESC"
            printf 'mode: subagent\n'
            printf -- '---\n\n'
            awk 'BEGIN { n = 0 } /^---$/ { n++; next } n >= 2 { print }' "$OMP_AGENT_FILE"
        } > "$OPENCODE_AGENT_DIR/omp-$OMP_AGENT_NAME.md"
    done
fi

# OMP's managed skills already use the SKILL.md layout OpenCode discovers, but
# OpenCode does not follow a symlinked source root. Link each skill directory.
OPENCODE_SKILL_DIR="$OPENCODE_CONFIG_DIR/skills"

if [[ -d "$OMP_CONFIG_DIR/managed-skills" ]]; then
    if [[ -L "$OPENCODE_SKILL_DIR" ]]; then
        rm -f -- "$OPENCODE_SKILL_DIR"
    fi

    mkdir -p -- "$OPENCODE_SKILL_DIR"

    for OMP_SKILL_DIR in "$OMP_CONFIG_DIR/managed-skills"/*/; do
        [[ -f "$OMP_SKILL_DIR/SKILL.md" ]] || continue

        OMP_SKILL_NAME="$(basename "$OMP_SKILL_DIR")"
        ln -sfn "../../../.omp/agent/managed-skills/$OMP_SKILL_NAME" \
            "$OPENCODE_SKILL_DIR/$OMP_SKILL_NAME"
    done
fi

# ============================================================
# Existing container check
# ============================================================

if podman container exists "$CONTAINER_NAME"; then
    STATUS="$(podman inspect \
        --format '{{.State.Status}}' \
        "$CONTAINER_NAME" 2>/dev/null || echo unknown)"

    fail "Container $CONTAINER_NAME already exists (status: $STATUS). Inspect with podman ps -a or remove with podman rm -f $CONTAINER_NAME."
fi

# ============================================================
# Allocate unique available ports
# ============================================================

port_is_free() {
    local listeners

    listeners="$(ss -H -ltn "sport = :$1" 2>/dev/null)" || return 1

    [[ -z "$listeners" ]]
}

PORT_OFFSET=""

for ((offset = 0; offset <= MAX_PORT_OFFSET; offset += PORT_STEP)); do

    CANDIDATE_OMP=$((BASE_OMP_PORT + offset))
    CANDIDATE_VITE=$((BASE_VITE_PORT + offset))
    CANDIDATE_API=$((BASE_API_PORT + offset))

    if port_is_free "$CANDIDATE_OMP" &&
       port_is_free "$CANDIDATE_VITE" &&
       port_is_free "$CANDIDATE_API"; then

        PORT_OFFSET="$offset"

        PORT_OMP="$CANDIDATE_OMP"
        PORT_VITE="$CANDIDATE_VITE"
        PORT_API="$CANDIDATE_API"

        break
    fi
done

[[ -n "$PORT_OFFSET" ]] || \
    fail "No available port allocation found."

# ============================================================
# Herdr OMP integration
# ============================================================

HERDR_MOUNT_ARGS=()

if [[ "${HERDR_ENV:-}" == "1" ]]; then

    [[ -n "${HERDR_PANE_ID:-}" ]] || \
        fail "HERDR_PANE_ID is missing."

    [[ -n "${HERDR_SOCKET_PATH:-}" ]] || \
        fail "HERDR_SOCKET_PATH is missing."

    [[ -S "$HERDR_SOCKET_PATH" ]] || \
        fail "Herdr socket not found: $HERDR_SOCKET_PATH"

    if [[ "$HARNESS" == "omp" ]]; then
        HERDR_OMP_EXTENSION="$OMP_CONFIG_DIR/extensions/herdr-omp-agent-state.ts"

        [[ -f "$HERDR_OMP_EXTENSION" ]] || \
            fail "Install the OMP integration with: herdr integration install omp"
    fi

    # Expose only the active Herdr socket.
    HERDR_MOUNT_ARGS+=(
        --mount "type=bind,src=$HERDR_SOCKET_PATH,dst=/run/herdr.sock"
        --env HERDR_ENV=1
        --env "HERDR_PANE_ID=$HERDR_PANE_ID"
        --env HERDR_SOCKET_PATH=/run/herdr.sock
    )
fi

# ============================================================
# Display configuration
# ============================================================

printf '\nStarting development environment...\n\n'

printf 'Workspace:  %s\n' "$WORKSPACE_NAME"
printf 'Harness:   %s\n' "$HARNESS"

if [[ -n "$SESSION_ID" ]]; then
    printf 'Session:   resume %s\n' "$SESSION_ID"
else
    printf 'Session:   new\n'
fi
printf 'Container:  %s\n' "$CONTAINER_NAME"
printf 'Image:      %s\n' "$IMAGE"
printf 'Project:    %s\n' "$PROJECT_DIR"
printf 'OMP config: %s\n' "$OMP_CONFIG_DIR"
printf 'OpenCode config: %s\n' "$OPENCODE_CONFIG_DIR"
printf 'Qoder config:  %s\n' "$QODER_CONFIG_DIR"

if [[ -n "$GH_TOKEN_VALUE" ]]; then
    printf 'GitHub:     authenticated (GH_TOKEN)\n'
else
    printf 'GitHub:     not authenticated\n'
fi

printf '\nAllocated ports:\n'
printf '  OMP:      127.0.0.1:%s -> 3000\n' "$PORT_OMP"
printf '  Vite:     127.0.0.1:%s -> 5173\n' "$PORT_VITE"
printf '  API:      127.0.0.1:%s -> 8000\n\n' "$PORT_API"

# ============================================================
# Podman configuration
# ============================================================

PODMAN_ARGS=(
    run
    --rm
    -it
    --init
    --ulimit core=0

    --name "$CONTAINER_NAME"
    --hostname "$CONTAINER_NAME"
    --label "dev-container.workspace=$WORKSPACE_NAME"
    --label "dev-container.harness=$HARNESS"

    --userns="keep-id:uid=$CONTAINER_UID,gid=$CONTAINER_GID"

    --cap-drop=ALL
    --security-opt=no-new-privileges
    --pids-limit=512

    --publish "127.0.0.1:${PORT_OMP}:3000"
    --publish "127.0.0.1:${PORT_VITE}:5173"
    --publish "127.0.0.1:${PORT_API}:8000"

    --mount "type=bind,src=$PROJECT_DIR,dst=$CONTAINER_WORKSPACE_DIR,rw"

    "${GIT_READONLY_MOUNTS[@]}"

    --mount "type=bind,src=$OMP_CONFIG_DIR,dst=/home/dev/.omp/agent,rw"

    --mount "type=bind,src=$OPENCODE_CONFIG_DIR,dst=/home/dev/.config/opencode,ro"
    --mount "type=bind,src=$OPENCODE_DATA_DIR,dst=/home/dev/.local/share/opencode,rw"
    --mount "type=bind,src=$OPENCODE_STATE_DIR,dst=/home/dev/.local/state/opencode,rw"
    --mount "type=bind,src=$QODER_CONFIG_DIR,dst=/home/dev/.qoder,rw"

    "${OMP_READONLY_MOUNTS[@]}"
    "${QODER_READONLY_MOUNTS[@]}"
    "${OMP_PLUGIN_MOUNTS[@]}"
    "${SKILL_MOUNTS[@]}"

    --workdir="$CONTAINER_WORKSPACE_DIR"

    --env PI_CODING_AGENT_DIR=/home/dev/.omp/agent
    --env "PI_CODING_AGENT_SESSION_DIR=$OMP_SESSION_DIR"
    --env QODER_CONFIG_DIR=/home/dev/.qoder
    --env COLORTERM

    "${HERDR_MOUNT_ARGS[@]}"
)

if [[ -n "$GH_TOKEN_VALUE" ]]; then
    PODMAN_ARGS+=(--env GH_TOKEN)
fi

# ============================================================
# Launch
# ============================================================

# Herdr must identify the host-side Podman wrapper as OMP.
if [[ "${HERDR_ENV:-}" == "1" && "$HARNESS" == "omp" ]]; then
    HERDR_AGENT=omp exec podman "${PODMAN_ARGS[@]}" "$IMAGE" "$HARNESS" "${HARNESS_ARGS[@]}"
else
    exec podman "${PODMAN_ARGS[@]}" "$IMAGE" "$HARNESS" "${HARNESS_ARGS[@]}"
fi
