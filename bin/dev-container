#!/usr/bin/env bash
set -Eeuo pipefail

# ============================================================
# Configuration
# ============================================================

IMAGE="localhost/thoth:debian13"
WORKSPACES_DIR="/data/llms/agent_workspaces"
CONTAINER_PREFIX="thoth"

CONTAINER_UID=1000
CONTAINER_GID=1000

BASE_OMP_PORT=3000
BASE_VITE_PORT=5173
BASE_API_PORT=8000

PORT_STEP=1000
MAX_PORT_OFFSET=57000

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

# Prompt for a 1-based index into a list of $2 items.
# Prints the chosen index on stdout; prompts and diagnostics go to stderr.
prompt_choice() {
    local prompt="$1"
    local count="$2"
    local choice

    while true; do
        read -r -p "$prompt" choice || return 1

        case "${choice,,}" in
            q|quit|exit)
                printf 'Cancelled.\n' >&2
                return 1
                ;;
        esac

        [[ "$choice" =~ ^[0-9]+$ ]] || {
            printf 'Invalid selection.\n' >&2
            continue
        }

        choice=$((10#$choice))

        if (( choice < 1 || choice > count )); then
            printf 'Choose a number between 1 and %d.\n' "$count" >&2
            continue
        fi

        printf '%d\n' "$choice"
        return 0
    done
}

# ============================================================
# Requirements
# ============================================================

command -v podman >/dev/null 2>&1 || fail "Podman is not installed."
command -v omp >/dev/null 2>&1 || fail "OMP is not installed."
command -v ss >/dev/null 2>&1 || fail "Install iproute2 (ss is required)."

(( $# == 0 )) || fail "Run dev-container without arguments to open the workspace menu."

[[ -d "$WORKSPACES_DIR" ]] || \
    fail "Workspace directory does not exist: $WORKSPACES_DIR"

# ============================================================
# Scan workspaces
# ============================================================

# Only scan immediate, non-hidden directories.
# Files such as Dockerfile are ignored.

mapfile -d '' -t WORKSPACES < <(
    find "$WORKSPACES_DIR" \
        -mindepth 1 -maxdepth 1 \
        -type d ! -name '.*' \
        -printf '%f\0' | sort -z
)

((${#WORKSPACES[@]} > 0)) || \
    fail "No workspace directories found in: $WORKSPACES_DIR"

# Absolute path of every scanned workspace, indexed like WORKSPACES.
WORKSPACE_PATHS=()

for WORKSPACE_ENTRY in "${WORKSPACES[@]}"; do
    WORKSPACE_PATHS+=("$WORKSPACES_DIR/$WORKSPACE_ENTRY")
done

# Offer the current working directory as the first entry unless the
# scan already lists it.
CURRENT_DIR="$(pwd -P)" || \
    fail "Cannot resolve the current working directory."

CURRENT_DIR_NAME="${CURRENT_DIR##*/}"
CURRENT_DIR_LISTED=0

for WORKSPACE_PATH in "${WORKSPACE_PATHS[@]}"; do
    if [[ "$WORKSPACE_PATH" == "$CURRENT_DIR" ]]; then
        CURRENT_DIR_LISTED=1
        break
    fi
done

if (( CURRENT_DIR_LISTED == 0 )); then
    [[ -n "$CURRENT_DIR_NAME" ]] || CURRENT_DIR_NAME="/"

    WORKSPACES=("$CURRENT_DIR_NAME" "${WORKSPACES[@]}")
    WORKSPACE_PATHS=("$CURRENT_DIR" "${WORKSPACE_PATHS[@]}")
fi

# ============================================================
# Workspace selection
# ============================================================

[[ -t 0 ]] || \
    fail "Interactive selection requires a terminal."

printf '\nAvailable workspaces:\n\n'

for i in "${!WORKSPACES[@]}"; do
    if [[ "${WORKSPACE_PATHS[$i]}" == "$CURRENT_DIR" ]]; then
        printf '  %2d) %s (current directory)\n' "$((i + 1))" "${WORKSPACES[$i]}"
    else
        printf '  %2d) %s\n' "$((i + 1))" "${WORKSPACES[$i]}"
    fi
done

printf '\n'

SELECTION_NUMBER="$(prompt_choice "Select workspace number (or q to quit): " "${#WORKSPACES[@]}")" || exit 0

SELECTED_INDEX=$((SELECTION_NUMBER - 1))

WORKSPACE_NAME="${WORKSPACES[$SELECTED_INDEX]}"
PROJECT_DIR="${WORKSPACE_PATHS[$SELECTED_INDEX]}"
CONTAINER_NAME="$CONTAINER_PREFIX-$WORKSPACE_NAME"

[[ "$WORKSPACE_NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || \
    fail "Invalid workspace name: $WORKSPACE_NAME"

# ============================================================
# Agent harness selection
# ============================================================

# Harness command executed inside the container, in menu order.
AGENT_HARNESSES=(omp opencode qoder)

printf '\nAvailable agent harnesses:\n\n'

for i in "${!AGENT_HARNESSES[@]}"; do
    printf '  %2d) %s\n' "$((i + 1))" "${AGENT_HARNESSES[$i]}"
done

printf '\n'

HARNESS_NUMBER="$(prompt_choice "Select harness number (or q to quit): " "${#AGENT_HARNESSES[@]}")" || exit 0

HARNESS="${AGENT_HARNESSES[$((HARNESS_NUMBER - 1))]}"

# ============================================================
# OMP configuration
# ============================================================

OMP_CONFIG_DIR="$(omp config path)"

[[ -n "$OMP_CONFIG_DIR" ]] || \
    fail "OMP returned an empty configuration path."

[[ -d "$OMP_CONFIG_DIR" ]] || \
    fail "OMP configuration not found: $OMP_CONFIG_DIR"

podman image exists "$IMAGE" || \
    fail "Container image not found: $IMAGE"

# ============================================================
# Agent harness configuration
# ============================================================

OPENCODE_CONFIG_DIR="$HOME/.config/opencode"
OPENCODE_DATA_DIR="$HOME/.local/share/opencode"
QODER_CONFIG_DIR="$HOME/.qoder"

mkdir -p -- "$OPENCODE_CONFIG_DIR" "$OPENCODE_DATA_DIR" "$QODER_CONFIG_DIR"

# ============================================================
# Existing container check
# ============================================================

if podman container exists "$CONTAINER_NAME"; then
    STATUS="$(podman inspect \
        --format '{{.State.Status}}' \
        "$CONTAINER_NAME" 2>/dev/null || echo unknown)"

    fail "Container $CONTAINER_NAME already exists (status: $STATUS). Inspect with podman ps -a or remove with podman rm -f $CONTAINER_NAME."
fi

# ============================================================
# Allocate unique available ports
# ============================================================

port_is_free() {
    local listeners

    listeners="$(ss -H -ltn "sport = :$1" 2>/dev/null)" || return 1

    [[ -z "$listeners" ]]
}

PORT_OFFSET=""

for ((offset = 0; offset <= MAX_PORT_OFFSET; offset += PORT_STEP)); do

    CANDIDATE_OMP=$((BASE_OMP_PORT + offset))
    CANDIDATE_VITE=$((BASE_VITE_PORT + offset))
    CANDIDATE_API=$((BASE_API_PORT + offset))

    if port_is_free "$CANDIDATE_OMP" &&
       port_is_free "$CANDIDATE_VITE" &&
       port_is_free "$CANDIDATE_API"; then

        PORT_OFFSET="$offset"

        PORT_OMP="$CANDIDATE_OMP"
        PORT_VITE="$CANDIDATE_VITE"
        PORT_API="$CANDIDATE_API"

        break
    fi
done

[[ -n "$PORT_OFFSET" ]] || \
    fail "No available port allocation found."

# ============================================================
# Herdr OMP integration
# ============================================================

HERDR_MOUNT_ARGS=()

if [[ "${HERDR_ENV:-}" == "1" ]]; then

    [[ -n "${HERDR_PANE_ID:-}" ]] || \
        fail "HERDR_PANE_ID is missing."

    [[ -n "${HERDR_SOCKET_PATH:-}" ]] || \
        fail "HERDR_SOCKET_PATH is missing."

    [[ -S "$HERDR_SOCKET_PATH" ]] || \
        fail "Herdr socket not found: $HERDR_SOCKET_PATH"

    if [[ "$HARNESS" == "omp" ]]; then
        HERDR_OMP_EXTENSION="$OMP_CONFIG_DIR/extensions/herdr-omp-agent-state.ts"

        [[ -f "$HERDR_OMP_EXTENSION" ]] || \
            fail "Install the OMP integration with: herdr integration install omp"
    fi

    # Expose only the active Herdr socket.
    HERDR_MOUNT_ARGS+=(
        --mount "type=bind,src=$HERDR_SOCKET_PATH,dst=/run/herdr.sock"
        --env HERDR_ENV=1
        --env "HERDR_PANE_ID=$HERDR_PANE_ID"
        --env HERDR_SOCKET_PATH=/run/herdr.sock
    )
fi

# ============================================================
# Display configuration
# ============================================================

printf '\nStarting development environment...\n\n'

printf 'Workspace:  %s\n' "$WORKSPACE_NAME"
printf 'Harness:   %s\n' "$HARNESS"
printf 'Container:  %s\n' "$CONTAINER_NAME"
printf 'Image:      %s\n' "$IMAGE"
printf 'Project:    %s\n' "$PROJECT_DIR"
printf 'OMP config: %s\n' "$OMP_CONFIG_DIR"
printf 'OpenCode config: %s\n' "$OPENCODE_CONFIG_DIR"
printf 'Qoder config:  %s\n' "$QODER_CONFIG_DIR"

printf '\nAllocated ports:\n'
printf '  OMP:      127.0.0.1:%s -> 3000\n' "$PORT_OMP"
printf '  Vite:     127.0.0.1:%s -> 5173\n' "$PORT_VITE"
printf '  API:      127.0.0.1:%s -> 8000\n\n' "$PORT_API"

# ============================================================
# Podman configuration
# ============================================================

PODMAN_ARGS=(
    run
    --rm
    -it

    --name "$CONTAINER_NAME"

    --userns="keep-id:uid=$CONTAINER_UID,gid=$CONTAINER_GID"

    --cap-drop=ALL
    --security-opt=no-new-privileges
    --pids-limit=512

    --publish "127.0.0.1:${PORT_OMP}:3000"
    --publish "127.0.0.1:${PORT_VITE}:5173"
    --publish "127.0.0.1:${PORT_API}:8000"

    --mount "type=bind,src=$PROJECT_DIR,dst=/workspace,rw"

    --mount "type=bind,src=$OMP_CONFIG_DIR,dst=/home/dev/.omp/agent,rw"

    --mount "type=bind,src=$OPENCODE_CONFIG_DIR,dst=/home/dev/.config/opencode,rw"
    --mount "type=bind,src=$OPENCODE_DATA_DIR,dst=/home/dev/.local/share/opencode,rw"
    --mount "type=bind,src=$QODER_CONFIG_DIR,dst=/home/dev/.qoder,rw"

    --workdir=/workspace

    --env PI_CODING_AGENT_DIR=/home/dev/.omp/agent
    --env QODER_CONFIG_DIR=/home/dev/.qoder

    "${HERDR_MOUNT_ARGS[@]}"
)

# ============================================================
# Launch
# ============================================================

# Herdr must identify the host-side Podman wrapper as OMP.
if [[ "${HERDR_ENV:-}" == "1" && "$HARNESS" == "omp" ]]; then
    HERDR_AGENT=omp exec podman "${PODMAN_ARGS[@]}" "$IMAGE" "$HARNESS"
else
    exec podman "${PODMAN_ARGS[@]}" "$IMAGE" "$HARNESS"
fi
